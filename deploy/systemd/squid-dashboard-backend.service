# Example systemd unit for running the backend directly on a server without
# Docker. Install:
#
#   sudo cp deploy/systemd/squid-dashboard-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now squid-dashboard-backend
#
# Assumes the app is checked out to /opt/squid-dashboard/backend with a venv
# at /opt/squid-dashboard/backend/.venv (see README.md) and a populated
# /opt/squid-dashboard/backend/.env. Adjust User/paths for your environment.

[Unit]
Description=Squid Proxy Log Analytics — backend
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=squid-dashboard
Group=squid-dashboard
WorkingDirectory=/opt/squid-dashboard/backend
EnvironmentFile=/opt/squid-dashboard/backend/.env
# Applies any pending Alembic migrations before the app starts -- the app's
# own init_db() only ever creates tables that don't exist yet, it never
# alters existing ones, so this is required for schema changes to actually
# land on upgrade. Runs with the same WorkingDirectory/EnvironmentFile as
# ExecStart below, so alembic picks up DATABASE_URL the same way the app does.
ExecStartPre=/opt/squid-dashboard/backend/.venv/bin/alembic upgrade head
# --proxy-headers/--forwarded-allow-ips=127.0.0.1: trusts X-Forwarded-For
# from the local nginx (deploy/nginx/squid-dashboard.conf) only -- this
# already binds to 127.0.0.1, so nothing else can spoof it. Without this,
# every request's peer is nginx itself, and per-IP rate limiting
# (app/core/rate_limit.py) collapses into one bucket shared by every client.
ExecStart=/opt/squid-dashboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

# The log tailer needs read access to Squid's access.log; the ProtectSystem
# sandbox below still allows that since it only restricts writes.
ProtectSystem=strict
ReadWritePaths=/opt/squid-dashboard/backend
ReadOnlyPaths=/var/log/squid
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
