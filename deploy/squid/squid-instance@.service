# Templated systemd unit for running multiple squid instances from one
# binary, each with its own config/PID file -- based on the official Ubuntu
# squid package's own /lib/systemd/system/squid.service (same Type=notify,
# --foreground -sYC invocation), just parameterized by %i (the instance
# name after the @).
#
# Install once, then enable per instance (see ../README.md):
#
#   sudo cp deploy/squid/squid-instance@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now squid-instance@filiallar
#   sudo systemctl enable --now squid-instance@bosh_ofis
#   sudo systemctl enable --now squid-instance@serverlar
#   sudo systemctl enable --now squid-instance@trafik
#
# Each %i must match the corresponding deploy/squid/squid-<name>.conf's own
# filename stem and the branch tag used in docker-compose.override.yml's
# LOG_SOURCES.

[Unit]
Description=Squid Proxy instance: %i
Documentation=man:squid(8)
After=local-fs.target network.target network-online.target nss-lookup.target

[Service]
Type=notify
PIDFile=/run/squid-%i.pid
Group=proxy
ExecStartPre=/usr/sbin/squid -f /etc/squid/squid-%i.conf --foreground -z
ExecStart=/usr/sbin/squid -f /etc/squid/squid-%i.conf --foreground -sYC
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
NotifyAccess=all
Restart=on-failure
RestartSec=5

# Squid starts as root (needed for http_port <1024 in some deployments and
# to open its cache dirs) then drops to cache_effective_user/group itself --
# NoNewPrivileges doesn't interfere with that self-initiated setuid/setgid,
# it only blocks *gaining* privileges via execve, so this is safe alongside
# the ExecStartPre -z cache-init step above.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Scoped to exactly what this instance needs to write, not the whole shared
# /run tmpfs -- PIDFile= above is a plain top-level file (not a per-service
# subdirectory), so ReadWritePaths targets that same file directly rather
# than opening every other service's /run entries to this process too.
# systemd bind-mounts a fresh empty file here on first start if it doesn't
# exist yet, same as for the directories below.
ReadWritePaths=/var/spool/squid-%i /var/log/squid-%i /run/squid-%i.pid

[Install]
WantedBy=multi-user.target
