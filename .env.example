# Used by docker-compose.yml (docker-compose reads .env from this directory
# automatically). Copy to .env and fill in real values before running
# `docker compose up`. This is separate from backend/.env.example, which is
# for running the backend directly (not via Docker).

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_RUN_python_-c_"import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional: override the published host ports if 8000/8080 are already in use.
# BACKEND_PORT=8000
# FRONTEND_PORT=8080

# Optional: allowed CORS origin(s), as a JSON array. Defaults to
# ["http://localhost:8080"] (the bundled frontend container's own published
# port) -- override once this is served behind a real domain, e.g.:
# CORS_ORIGINS=["https://dashboard.example.com"]

# Optional: the db-backup service's schedule/retention (see "Database
# backups" in README.md). Defaults shown -- daily, keep 30 days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=30

# Optional: error tracking -- unhandled exceptions otherwise only ever go to
# stdout. Needs your own Sentry (or compatible) project/DSN.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: UT1 bulk domain blacklist for automatic categorization (see
# "Domain categorization" in README.md). Off by default -- reaches a
# third-party server over the internet at runtime, so this is an explicit
# opt-in rather than silently enabled.
# UT1_ENABLED=true

# Optional: capacity tuning for large deployments (see "Capacity planning
# for large deployments" in README.md). Defaults shown match the small/demo
# scale defaults -- uncomment and raise for a large deployment (tens of
# thousands of proxied clients).
# RING_BUFFER_MAX_EVENTS=500000
# AGGREGATION_INTERVAL_SECONDS=60
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Optional: how many days of full per-request detail (client IP, URL,
# domain) stay queryable in the live database before being purged (default
# 30 -- see backend/.env.example's RETENTION_DAYS_RAW_EVENTS). Raise only
# alongside real disk headroom; see "Sizing for a large client count" in
# ARCHITECTURE.md for the per-day disk-cost math.
# RETENTION_DAYS_RAW_EVENTS=30

# Optional: encrypts weekly raw-event archive files at rest before they ever
# touch disk (see "Archiving raw event detail before it's purged" in
# backend/.env.example). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset (the default) writes archives as plain gzip, matching every archive
# a deployment predating this setting already wrote. Keep a copy of this
# key somewhere other than this server -- losing it means losing the
# ability to ever read past archives.
# ARCHIVE_ENCRYPTION_KEY=

# Optional: container resource limits (safety caps against a runaway
# process starving the host, not sizing guidance) -- raise alongside the
# capacity settings above for a large deployment. Defaults: 2 CPUs / 1GiB
# each for backend and postgres.
# BACKEND_CPU_LIMIT=2
# BACKEND_MEMORY_LIMIT=1g
# POSTGRES_CPU_LIMIT=2
# POSTGRES_MEMORY_LIMIT=1g

# Optional: traffic-anomaly alerting webhook (see "Category/quota alerting
# and scheduled reports" in README.md). Off by default.
# ALERT_WEBHOOK_URL=https://hooks.example.com/traffic-anomalies
# ALERT_MIN_SEVERITY=high

# Optional: operator-facing infra-failure alerting webhook -- the log
# tailer dying, a backup/retention/archiving job failing (see "Operator
# failure notifications" in README.md). Falls back to ALERT_WEBHOOK_URL
# above if unset, so a single-webhook operator needs only one of these.
# OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/ops-alerts

# Optional: Telegram alerting, alongside ALERT_WEBHOOK_URL above (same
# ALERT_MIN_SEVERITY gate) -- see "Category/quota alerting" in README.md.
# TELEGRAM_BOT_TOKEN gets every branch's alerts via TELEGRAM_SUPER_ADMIN_CHAT_ID;
# each branch's own chat is set per branch by that branch's admin at
# Settings -> Alert settings, not here. Off by default.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
# TELEGRAM_SUPER_ADMIN_CHAT_ID=-1001234567890
