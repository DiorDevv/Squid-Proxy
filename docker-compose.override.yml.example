# Real-deployment override: points the backend at your actual Squid
# access.log instead of the synthetic demo generator's volume.
#
# Usage (on the server where Squid itself runs, so the path below is a real
# local path Docker can bind-mount):
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   # edit the host path below to match your Squid install
#   docker compose up --build -d          # note: no --profile demo
#
# `docker-compose.override.yml` is picked up automatically by `docker
# compose` (it merges on top of docker-compose.yml) and is gitignored, so
# your real log path never gets committed.

services:
  backend:
    volumes:
      # Left side: the real path to Squid's log directory on this host.
      # Common defaults: /var/log/squid (Debian/Ubuntu), /var/log/squid3.
      - /var/log/squid:/data/squid-logs:ro

# --- Large-deployment capacity tuning (~30,000+ proxied clients) ---
# Commented out -- this is a second example, not applied by default.
#
# The RING_BUFFER_MAX_EVENTS/AGGREGATION_INTERVAL_SECONDS/DATABASE_POOL_SIZE/
# DATABASE_MAX_OVERFLOW/BACKEND_MEMORY_LIMIT/BACKEND_CPU_LIMIT/
# POSTGRES_MEMORY_LIMIT/POSTGRES_CPU_LIMIT settings below are all plain env
# vars docker-compose.yml already reads (see .env.example) -- set them in
# `.env` directly rather than overriding here. Only the Postgres tuning
# flags (write-heavy workload, benefits far more from these than Postgres's
# own light-workload defaults) need an override file, since docker-compose.yml
# has no env var for arbitrary `command:` flags. Adjust every number below to
# your actual measured load -- see "Capacity planning for large deployments"
# in README.md for the reasoning behind these specific values and how to
# verify them against your own hardware.
#
# .env:
#   RING_BUFFER_MAX_EVENTS=1000000
#   AGGREGATION_INTERVAL_SECONDS=30
#   DATABASE_POOL_SIZE=10
#   DATABASE_MAX_OVERFLOW=20
#   BACKEND_MEMORY_LIMIT=6g
#   BACKEND_CPU_LIMIT=2
#   POSTGRES_MEMORY_LIMIT=8g
#   POSTGRES_CPU_LIMIT=4
#
# docker-compose.override.yml:
# services:
#   postgres:
#     command:
#       - "postgres"
#       - "-c"
#       - "shared_buffers=2GB"
#       - "-c"
#       - "effective_cache_size=6GB"
#       - "-c"
#       - "max_wal_size=4GB"

# --- Docker build can't resolve external domains ---
# Commented out -- a third example, not applied by default.
#
# Symptom: `docker compose build frontend` hangs or fails on `npm ci` with
# `getaddrinfo ENOTFOUND registry.npmjs.org` (backend: pip install failing
# to reach pypi.org/files.pythonhosted.org the same way) -- even though the
# host itself resolves those domains fine. Cause: the host's real resolver
# (e.g. systemd-resolved's 127.0.0.53) isn't reachable from inside a build
# container's own network namespace, so Docker substitutes whatever
# upstream server(s) it finds in the *legacy* resolv.conf instead
# (`resolvectl status`) -- on a network with an internal/corporate DNS
# server that only serves internal zones and SERVFAILs anything external,
# every container build inherits that, while the host (which never asked
# that server directly) keeps working.
#
# `--dns` isn't available as a build flag on current Docker (only `docker
# run`, not `docker build`/`buildx build`, accepts it) -- the supported
# fix is pinning the specific host(s) via `extra_hosts` under `build:`,
# which does get honored during a build (verified: forces a real DNS
# bypass for that name specifically, tested with `--no-cache` to confirm
# it isn't just reusing an already-resolved cached layer). Resolve the
# current IP from somewhere DNS *does* work (the host itself, or your own
# machine) right before building -- these IPs aren't guaranteed stable
# forever, so re-resolve if this ever starts failing again rather than
# trusting an old value:
#
#   getent ahostsv4 registry.npmjs.org | head -1
#
# docker-compose.override.yml:
# services:
#   frontend:
#     build:
#       extra_hosts:
#         - "registry.npmjs.org:<resolved IP>"
#   backend:
#     build:
#       extra_hosts:
#         - "pypi.org:<resolved IP>"
#         - "files.pythonhosted.org:<resolved IP>"
#         - "deb.debian.org:<resolved IP>"
