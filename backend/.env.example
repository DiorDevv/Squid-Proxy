# Copy this file to .env and fill in real values. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Squid log source ---
# Squid's access_log directive MUST use the "squid" native logformat, e.g.:
#   access_log /var/log/squid/access.log squid
# "common"/"combined" or a custom logformat will fail to parse -- see
# README.md's "Required Squid configuration" section, and check
# GET /api/health (log_parse_failure_rate) after pointing at a real Squid.
LOG_FILE_PATH=/var/log/squid/access.log
# For multiple branches/sites (each with its own Squid server), set
# LOG_SOURCES instead -- a JSON array of {"branch": "...", "path": "..."},
# one per branch. LOG_FILE_PATH is then ignored. Each path is expected to
# already be a local file on this server; see deploy/rsyslog/ and
# README.md's "Multi-branch deployment" section for how to get each
# branch's access.log here in real time over TLS.
# LOG_SOURCES=[{"branch":"tashkent","path":"/var/log/squid/tashkent.log"},{"branch":"samarqand","path":"/var/log/squid/samarqand.log"}]
LOG_TAILER_POLL_INTERVAL_SECONDS=0.75
LOG_TAILER_BACKOFF_MAX_SECONDS=30
# Where each branch's read position (inode + byte offset) is persisted, so
# a restart resumes exactly where it left off instead of silently skipping
# whatever Squid wrote while the backend was down.
LOG_TAILER_STATE_DIR=./log_tailer_state

# --- Database ---
# SQLite (default, zero external services needed):
DATABASE_URL=sqlite+aiosqlite:///./squid_dashboard.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://squid:squid@localhost:5432/squid_dashboard
# Connection pool size (Postgres only, ignored for SQLite). Defaults match
# SQLAlchemy's own library defaults. For a large deployment (tens of
# thousands of proxied clients), see "Capacity planning for large
# deployments" in README.md.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# --- In-memory ring buffer (raw events, most recent window) ---
RING_BUFFER_MAX_EVENTS=500000

# --- Retention ---
# 30 days: long enough that an incident noticed a couple weeks late still
# has per-request detail in the live, queryable database, not only in a
# weekly archive file. Raise further only alongside real disk headroom --
# see "Sizing for a large client count" in ARCHITECTURE.md for the per-day
# disk-cost math this scales from.
RETENTION_DAYS_RAW_EVENTS=30
RETENTION_DAYS_AGGREGATES=400
AGGREGATION_INTERVAL_SECONDS=60
RETENTION_PURGE_INTERVAL_SECONDS=3600
# client_minute_aggregates rows older than this are compressed into
# client_hourly_aggregates and the source minute rows deleted -- keeps wide
# time-range client queries fast at a large client count (see
# ARCHITECTURE.md's "Scaling to a large client count").
CLIENT_ROLLUP_AFTER_HOURS=48

# --- Automatic raw-event archiving (see "Archiving raw event detail before
# it's purged" below) -- runs before RETENTION_DAYS_RAW_EVENTS above purges
# the same data. Set ARCHIVE_ENABLED=false to manage this fully yourself
# instead (e.g. your own cron/systemd timer running
# scripts/archive_weekly_export.py).
ARCHIVE_ENABLED=true
ARCHIVE_OUTPUT_DIR=./archives
ARCHIVE_KEEP_DAYS=365
ARCHIVE_CHECK_INTERVAL_SECONDS=3600
ARCHIVE_MIN_INTERVAL_SECONDS=604800
# Archives hold the same client-IP/domain-visited detail as the live
# database -- unset, they sit on disk as plain gzip. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# then set it here to have every archive encrypted before it touches disk
# (decrypt with scripts/decrypt_archive.py). Store a copy of this key
# somewhere other than this server -- losing it means losing the ability to
# ever read past archives.
ARCHIVE_ENCRYPTION_KEY=

# --- Time-spent-per-domain estimation ---
SESSION_GAP_MINUTES=30

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_INSECURE_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14
WS_TICKET_EXPIRE_SECONDS=30

# --- First-boot admin bootstrap (only used if the users table is empty) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- CORS (JSON array of allowed frontend origins) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute
SENSITIVE_ACTION_RATE_LIMIT=20/minute

# --- Insights / anomaly detection ---
# noop: disabled (default). statistical: threshold-based traffic-spike,
# new-blocked-domain, and client-blocked-ratio detection (see app/insights/).
INSIGHTS_PROVIDER=noop

# --- Analytics: per-branch risk score model (see app/services/
# analytics_service.py). A JSON object; any key omitted keeps the
# documented default. Weights should sum to ~1. The defaults are a
# reasonable starting point, not a calibrated truth -- tune against a real
# deployment.
# RISK_MODEL={"weight_blocked_ratio": 0.3, "weight_sensitive_traffic": 0.25, "weight_anomalies": 0.25, "weight_quota_breaches": 0.1, "weight_uncategorized_domains": 0.1, "blocked_ratio_ceil": 0.4, "sensitive_share_ceil": 0.3, "anomaly_points_ceil": 40, "quota_breach_ceil": 5, "uncategorized_domains_ceil": 10, "band_medium": 40, "band_high": 70}
# Above this many time buckets, /api/analytics/category-trend coarsens an
# hourly request to daily (the response reports the granularity it used).
CATEGORY_TREND_MAX_BUCKETS=1500

# --- Alerting (optional; no-op unless ALERT_WEBHOOK_URL is set) ---
# Receives an HTTP POST with a JSON anomaly payload for each detected
# anomaly at or above ALERT_MIN_SEVERITY (low/medium/high/critical).
# ALERT_WEBHOOK_URL=https://hooks.example.com/squid-watch-alerts
ALERT_MIN_SEVERITY=high

# --- Operator-facing infra-failure alerts (optional; see
# app/services/ops_alerting.py) -- the log tailer dying, a backup/
# retention/archiving job failing. Distinct from the traffic-anomaly
# alerting above. Falls back to ALERT_WEBHOOK_URL if unset.
# OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/squid-watch-ops-alerts

# --- Telegram alerting (optional; no-op unless TELEGRAM_BOT_TOKEN is set)
# -- a second delivery channel alongside the webhook above, gated by the
# same ALERT_MIN_SEVERITY. One bot serves every chat: TELEGRAM_SUPER_ADMIN_CHAT_ID
# always gets every branch's alerts, and each branch's own chat
# (set per branch by that branch's admin at Settings -> Alert settings)
# gets only that branch's. See app/services/telegram_alerting.py.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
# TELEGRAM_SUPER_ADMIN_CHAT_ID=-1001234567890

# --- Error tracking (optional; no-op unless SENTRY_DSN is set) --
# unhandled exceptions otherwise only ever go to stdout.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Category/quota/uncategorized-domain monitor jobs (the thresholds
# themselves -- sensitive categories, non-work minutes, client daily quota,
# uncategorized-domain request count -- are admin-configurable at runtime
# via Settings, not here; these only control how often the background jobs
# re-check) ---
CATEGORY_MONITOR_INTERVAL_SECONDS=3600
QUOTA_MONITOR_INTERVAL_SECONDS=3600
UNCATEGORIZED_DOMAIN_MONITOR_INTERVAL_SECONDS=86400

# --- UT1 bulk domain blacklist (optional; no-op unless UT1_ENABLED=true) ---
# Supplements the small built-in known-hostname list (app/services/
# category_inference.py) with UT1's free, categorized domain lists
# (millions of domains, https://dsi.ut-capitole.fr/blacklists/) for
# gambling/adult/gaming/social/music/video-streaming/shopping/news. Off by
# default: this reaches a third-party server over the internet at runtime,
# which shouldn't happen silently for a compliance/security tool.
UT1_ENABLED=false
UT1_MIRROR_URL=https://dsi.ut-capitole.fr/blacklists/download/blacklists.tar.gz
# Where the downloaded/extracted category files are cached between refreshes
# (~120MB disk once populated) -- see docker-compose.yml's ut1_blacklist_data
# volume for the Docker deployment path.
UT1_DATA_DIR=./ut1_blacklist_data
UT1_REFRESH_INTERVAL_SECONDS=604800

# --- Scheduled email reports (optional; no-op unless REPORT_RECIPIENTS is
# set). REPORT_SCHEDULE: disabled | daily | weekly. ---
REPORT_SCHEDULE=disabled
# REPORT_RECIPIENTS=["compliance@example.com"]
REPORT_SCHEDULER_CHECK_INTERVAL_SECONDS=900
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=squid-watch@example.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM_ADDRESS=squid-watch@example.com
SMTP_USE_TLS=true
