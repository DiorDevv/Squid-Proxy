# Used by docker-compose.yml (docker-compose reads .env from this directory
# automatically). Copy to .env and fill in real values before running
# `docker compose up`. This is separate from backend/.env.example, which is
# for running the backend directly (not via Docker).

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_RUN_python_-c_"import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional: override the published host ports if 8000/8080 are already in use.
# BACKEND_PORT=8000
# FRONTEND_PORT=8080

# Optional: the db-backup service's schedule/retention (see "Database
# backups" in README.md). Defaults shown -- daily, keep 30 days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=30

# Optional: error tracking -- unhandled exceptions otherwise only ever go to
# stdout. Needs your own Sentry (or compatible) project/DSN.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
