# Copy to /etc/squid-ssh-stream/<branch>.env (one copy per branch, e.g.
# /etc/squid-ssh-stream/filiallar.env) and fill in real values -- see
# squid-ssh-stream@.service's header comment for the full setup sequence.

# Path (on THIS/central server) to the dedicated keypair generated for this
# branch in step 1 of the setup sequence. Never reuse one key across
# branches -- see that step's reasoning.
SSH_KEY_PATH=/home/YOUR_USER/.ssh/id_squidreader_BRANCH_NAME

# The account on the BRANCH (Squid) server this connects as -- must match
# whichever account's authorized_keys the public key was restricted into
# in step 2.
SQUID_SSH_USER=squidreader

# The branch (Squid) server's address.
SQUID_SSH_HOST=203.0.113.10

# Path to access.log on the BRANCH server -- must be the native `squid`
# logformat, same requirement as every other ingestion path (see README.md's
# "Required Squid configuration").
SQUID_ACCESS_LOG_PATH=/var/log/squid/access.log

# Where this stream writes ON THIS (central) server -- point this branch's
# LOG_SOURCES entry at this same path.
LOCAL_LOG_PATH=/home/YOUR_USER/squid-watch/ssh-logs/BRANCH_NAME.log
